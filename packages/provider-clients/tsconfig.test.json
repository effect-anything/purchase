{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "include": ["src", "test"],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node", "vitest"]
  }
}
